# Application identity shown in FastAPI metadata and the MCP server.
APP_NAME=Weather Info

# Local host and port for development.
HOST=127.0.0.1
PORT=8000

# Public URL that ChatGPT should use when adding the connector.
# In production, set this to the exact HTTPS URL assigned by Heroku.
PUBLIC_BASE_URL=

# Origins allowed to call the app from a browser context.
ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com

# Small safety limit so forecast requests stay fast inside ChatGPT.
FORECAST_DAYS_LIMIT=5

# Optional Cloudflare alternative. Heroku deployments can leave these blank/defaulted.
CLOUDFLARE_TUNNEL_NAME=weather-info
CLOUDFLARE_TUNNEL_HOSTNAME=

# Official OpenAI docs and platform links used by the integration inventory.
OPENAI_APPS_DOCS_URL=https://developers.openai.com/apps-sdk/
OPENAI_APPS_DEPLOY_URL=https://developers.openai.com/apps-sdk/deploy
OPENAI_PLATFORM_APPS_URL=https://platform.openai.com
